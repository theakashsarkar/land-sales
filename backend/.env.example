# --- Environment ---------------------------------------------------------
NODE_ENV=development
PORT=4001

# --- Database ------------------------------------------------------------
# SQLite (default, zero setup). The schema is Postgres-ready — to switch,
# change the provider in prisma/schema.prisma and point this at Postgres:
# DATABASE_URL="postgresql://user:password@host:5432/bhumilandmarks"
DATABASE_URL="file:./dev.db"

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-different-64-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed origins (the admin SPA dev server)
CORS_ORIGIN=http://localhost:5173

# --- Seed ----------------------------------------------------------------
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@bhumilandmarks.com
SUPER_ADMIN_PASSWORD=ChangeMe!123
